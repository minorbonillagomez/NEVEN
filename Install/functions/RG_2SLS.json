    { "id": 3, "label": "Test de endogeneidad Wu-Hausman" },
    { "id": 4, "label": "Test de instrumentos debiles (F primera etapa)" },
    { "id": 5, "label": "Test de sobreidentificacion Sargan" },
    { "id": 9, "label": "Informacion de ejecucion (formula, N, variables)" }

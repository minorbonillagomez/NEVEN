<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/popup_background"
        android:elevation="16dp">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- HEADER - Zona de arrastre -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/headerDragArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#10000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <!-- Indicador de arrastre + contador -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⋮⋮"
                    android:textSize="14sp"
                    android:textColor="#80000000" />

                <TextView
                    android:id="@+id/tvPopupCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="(2)"
                    android:textSize="12sp"
                    android:textColor="#C9A227"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Journal Name (app) -->
            <TextView
                android:id="@+id/tvJournalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JOURNAL OF MESSAGING"
                android:textSize="11sp"
                android:textColor="#80000000"
                android:fontFamily="serif"
                android:letterSpacing="0.15" />

            <!-- Botón cerrar -->
            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="×"
                android:textSize="22sp"
                android:textColor="#80000000"
                android:padding="4dp" />

        </LinearLayout>

        <!-- Línea separadora -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#10000000" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CUERPO DEL PAPER -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Autor -->
            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center" />

            <!-- Afiliación -->
            <TextView
                android:id="@+id/tvAffiliation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Departamento de Mensajería Instantánea"
                android:textSize="12sp"
                android:textColor="#80000000"
                android:fontFamily="sans-serif"
                android:textStyle="italic"
                android:textAlignment="center" />

            <!-- Línea decorativa -->
            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#20000000" />

            <!-- Etiqueta Abstract -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Abstract"
                android:textSize="11sp"
                android:textColor="#60000000"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:letterSpacing="0.05" />

            <!-- Contenido del mensaje (WebView para Markdown/LaTeX) -->
            <WebView
                android:id="@+id/wvContent"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:scrollbars="vertical"
                android:scrollbarStyle="insideOverlay" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Received: 26 Oct 2026, 09:15"
                android:textSize="11sp"
                android:textColor="#50000000"
                android:fontFamily="sans-serif"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FOOTER - Botones -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#08000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#05000000"
            android:padding="12dp">

            <!-- Fila de botones principales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <!-- Botón Abrir -->
                <TextView
                    android:id="@+id/btnOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abrir"
                    android:textSize="13sp"
                    android:textColor="#808080"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/btn_outline_gray"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <!-- Botón OK -->
                <TextView
                    android:id="@+id/btnOk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK"
                    android:textSize="13sp"
                    android:textColor="#C9A227"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/btn_outline_accent"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp" />

            </LinearLayout>

            <!-- Botón Cerrar Todo (visible cuando hay múltiples) -->
            <LinearLayout
                android:id="@+id/btnDismissAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/btn_dismiss_all"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDismissAllCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CERRAR TODO (3)"
                    android:textSize="12sp"
                    android:textColor="#808080"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEVEN AI Agent — Manifest de DESARROLLO
  ========================================
  Apunta a localhost:5556 en lugar de ai.neven.app.
  Usar exclusivamente para desarrollo y pruebas locales.

  Para activar: ejecutar sideload.ps1 con este archivo
    PowerShell -ExecutionPolicy Bypass -File sideload.ps1 -Manifest manifest.dev.xml
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="TaskPaneApp">

  <Id>b9c8d7e6-f5a4-3210-9876-fedcba654321</Id>
  <Version>1.0.0.0-dev</Version>
  <ProviderName>NEVEN Project</ProviderName>
  <DefaultLocale>es-419</DefaultLocale>
  <DisplayName DefaultValue="NEVEN AI [DEV]"/>
  <Description DefaultValue="NEVEN AI Agent — modo desarrollo (localhost:5556)"/>

  <IconUrl DefaultValue="https://localhost:5556/static/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:5556/static/icon-64.png"/>
  <SupportUrl DefaultValue="https://localhost:5556"/>

  <AppDomains>
    <AppDomain>https://localhost:5556</AppDomain>
    <AppDomain>http://localhost:5556</AppDomain>
    <AppDomain>http://localhost:5555</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <!-- HTTP en desarrollo local — en producción usar HTTPS -->
    <SourceLocation DefaultValue="http://localhost:5556/"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

</OfficeApp>

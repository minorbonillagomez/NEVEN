<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
  <ribbon>
    <tabs>
      <tab id="tabRJ2XCL" label="NEVEN" insertAfterMso="TabHome">

        <!-- Grupo: Motores de Lenguaje -->
        <group id="grpEngines" label="Motores">
          <button id="btnReloadFunctions"
                  label="Actualizar"
                  size="large"
                  onAction="OnReloadCommand"
                  imageMso="Refresh"
                  screentip="Recargar funciones de usuario"
                  supertip="Recarga todos los archivos .R, .jl y .py de C:\NEVEN\functions\ sin reiniciar Excel. Use despues de agregar nuevas funciones." />

          <button id="btnEngineStatus"
                  label="Estado"
                  size="large"
                  onAction="OnEngineStatusCommand"
                  imageMso="ServerConnection"
                  screentip="Estado de los motores"
                  supertip="Muestra el estado de conexion de R, Julia y Python." />
        </group>

        <!-- Grupo: Analisis (nuevos viewers) -->
        <group id="grpAnalysis" label="Analisis">
          <button id="btnAIAssistant"
                  label="AI Assistant"
                  size="large"
                  onAction="OnAIAssistantCommand"
                  imageMso="BlogHomePage"
                  screentip="AI Assistant (LM Studio)"
                  supertip="Abre el asistente de IA conectado a LM Studio local. Resume, traduce, analiza y responde preguntas sobre sus datos." />

          <button id="btnTextAnalysis"
                  label="Texto"
                  size="large"
                  onAction="OnTextAnalysisCommand"
                  imageMso="ReviewCompareDocuments"
                  screentip="Analisis de Texto"
                  supertip="Analiza documentos PDF/TXT: Word Cloud, frecuencia, n-gramas, sentimiento y resumen." />

          <button id="btnSimulation"
                  label="Simulacion"
                  size="large"
                  onAction="OnSimulationCommand"
                  imageMso="ChartInsert"
                  screentip="Simulacion Monte Carlo"
                  supertip="Explorador reactivo de simulaciones Monte Carlo con sliders y comparacion de escenarios." />
        </group>

        <!-- Grupo: Visor -->
        <group id="grpViewer" label="Visor">
          <button id="btnViewerOpen"
                  label="Abrir Visor"
                  size="large"
                  onAction="OnViewerOpenCommand"
                  imageMso="PictureInsertFromFile"
                  screentip="Abrir visor HTML"
                  supertip="Abre un archivo HTML en el visor WebView2 embebido (Plotly, D3, dashboards)." />

          <button id="btnViewerCloseAll"
                  label="Cerrar Todos"
                  size="normal"
                  onAction="OnViewerCloseAllCommand"
                  imageMso="WindowCloseAllDocuments"
                  screentip="Cerrar todos los visores" />
        </group>

        <!-- Grupo: Notebooks y Pluto -->
        <group id="grpNotebooks" label="Notebooks">
          <button id="btnPlutoStart"
                  label="Pluto.jl"
                  size="large"
                  onAction="OnPlutoStartCommand"
                  imageMso="FileDocumentManagement"
                  screentip="Iniciar Pluto.jl"
                  supertip="Inicia el servidor de notebooks reactivos Pluto.jl. Los notebooks se abren en el visor WebView2." />

          <button id="btnNotebookList"
                  label="Biblioteca"
                  size="normal"
                  onAction="OnNotebookListCommand"
                  imageMso="ViewsGallery"
                  screentip="Biblioteca de notebooks" />

          <button id="btnPlutoStop"
                  label="Detener"
                  size="normal"
                  onAction="OnPlutoStopCommand"
                  imageMso="RecordStop"
                  screentip="Detener Pluto.jl" />
        </group>

        <!-- Grupo: Ayuda -->
        <group id="grpConfig" label="Ayuda">
          <button id="btnDocs"
                  label="Documentacion"
                  size="large"
                  onAction="OnDocsCommand"
                  imageMso="Help"
                  screentip="Documentacion NEVEN"
                  supertip="Abre la documentacion completa de NEVEN (13 capitulos) en el visor." />

          <button id="btnAbout"
                  label="Acerca de"
                  size="normal"
                  onAction="OnAboutCommand"
                  imageMso="Info"
                  screentip="Acerca de NEVEN"
                  supertip="NEVEN v2.1 — Open Source. Construyendo comunidad." />
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>

{"op": "create", "entity": {"id": "pattern_singleton", "type": "Pattern", "properties": {"name": "Singleton Pattern", "description": "Componentes principales usan singleton para garantizar instancia única.", "rationale": "Evita estados inconsistentes y simplifica acceso global.", "examples": ["RJ2XCL_Engine", "ViewerManager", "ConfigService", "LanguageManager"], "anti_patterns": ["Múltiples instancias de managers"]}}}
{"op": "create", "entity": {"id": "pattern_named_pipes", "type": "Pattern", "properties": {"name": "Named Pipes IPC", "description": "Comunicación entre XLL y procesos hijo via Named Pipes de Windows.", "rationale": "Aislamiento de memoria, crash de R no mata Excel, bidireccional.", "examples": ["\\\\.\\pipe\\NEVEN_R", "\\\\.\\pipe\\NEVEN_Julia", "\\\\.\\pipe\\NEVEN_Python"], "anti_patterns": ["Comunicación directa en memoria", "COM Automation para IPC"]}}}
{"op": "create", "entity": {"id": "pattern_protobuf", "type": "Pattern", "properties": {"name": "Protocol Buffers", "description": "Serialización de datos entre XLL y sidecars usando Protobuf.", "rationale": "Versionable, eficiente, independiente del lenguaje.", "examples": ["variable.proto", "Variable message"], "anti_patterns": ["JSON para IPC de alto volumen", "Serialización manual"]}}}
{"op": "create", "entity": {"id": "pattern_sta_thread", "type": "Pattern", "properties": {"name": "STA Thread for WebView2", "description": "WebView2 corre en thread STA dedicado por requerimiento COM.", "rationale": "COM apartment threading requerido por WebView2.", "examples": ["ViewerManager::STA_ThreadProc"], "anti_patterns": ["WebView2 en thread MTA", "WebView2 en main thread"]}}}
{"op": "create", "entity": {"id": "pattern_jsonl_ontology", "type": "Pattern", "properties": {"name": "JSONL Ontology", "description": "Ontologías almacenadas como JSON Lines: una operación por línea.", "rationale": "Append-only, fácil de versionar en git, streaming de lectura.", "examples": ["graph.jsonl", "op: create, op: relate"], "anti_patterns": ["JSON monolítico", "Base de datos relacional para ontología"]}}}
{"op": "create", "entity": {"id": "pattern_utf8_no_bom", "type": "Pattern", "properties": {"name": "UTF-8 sin BOM", "description": "Archivos R deben ser UTF-8 sin BOM para evitar errores de parsing.", "rationale": "R no maneja bien el BOM, causa errores de sintaxis.", "examples": ["[System.IO.File]::WriteAllText con UTF8Encoding($false)"], "anti_patterns": ["Copy-Item para archivos R", "Guardar con BOM"]}}}
{"op": "create", "entity": {"id": "workaround_quarto_spaces", "type": "Workaround", "properties": {"name": "Junction C:\\Quarto", "description": "Quarto tiene bug con espacios en ruta.", "issue": "Sass falla cuando ruta contiene espacios (Program Files).", "solution": "Crear junction: mklink /J C:\\Quarto C:\\Program Files\\Quarto", "affected_components": ["Quarto", "NEVEN.q()"], "date_identified": "2026-06"}}}
{"op": "create", "entity": {"id": "workaround_julia_sysimage", "type": "Workaround", "properties": {"name": "Julia Sysimage", "description": "Cold start de Julia toma minutos.", "issue": "Primera llamada a Julia demora 2-5 minutos por JIT compilation.", "solution": "Precompilar sysimage neven_julia.dll (~415MB) con paquetes frecuentes.", "affected_components": ["comp_controljulia"], "date_identified": "2026-05"}}}
{"op": "create", "entity": {"id": "workaround_db_lock", "type": "Workaround", "properties": {"name": "DuckDB Lock", "description": "DuckDB no permite múltiples conexiones de escritura.", "issue": "Script externo no puede abrir rag_index.duckdb mientras servidor está corriendo.", "solution": "Usar endpoint POST /api/rag/upload en lugar de script directo.", "affected_components": ["comp_rag_engine", "comp_duckdb"], "date_identified": "2026-08"}}}
